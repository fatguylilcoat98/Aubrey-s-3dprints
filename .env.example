# PrintBuddy — environment variables (BACKEND ONLY, never exposed to the browser)
# Copy to .env for local dev:  cp .env.example .env

NODE_ENV=production

# Mode 2 — AI text-to-3D. Tripo is the default (generous free tier).
# Sign up at https://platform.tripo3d.ai/  then paste the key here.
TRIPO_API_KEY=

# Optional alternative AI provider. https://www.meshy.ai/
MESHY_API_KEY=

# Mode 2 — prompt enhancer. Claude rewrites Aubrey's plain words into a
# print-ready prompt before it hits Tripo. Without this, a sensible
# deterministic fallback prompt is used instead. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Mode 1 — Thingiverse needs a free developer app token.
# https://www.thingiverse.com/developers  (Printables + MakerWorld need no key)
THINGIVERSE_API_KEY=
